<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop app: a second host next to hat, sharing its hat-config.json, plugins and databases. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="JetBrains.Annotations" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apophis.CLI\Apophis.CLI.csproj" />
    <ProjectReference Include="..\SortingHat.App\SortingHat.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the same configuration as hat, so both find the same databases -->
    <None Include="..\SortingHat.Console\hat-config.json" Link="hat-config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
