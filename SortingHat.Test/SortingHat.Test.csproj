<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\test.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <DotNetCliToolReference Include="dotnet-xunit" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\test.png">
      <CustomToolNamespace>Resource</CustomToolNamespace>
    </EmbeddedResource>
    <EmbeddedResource Include="Migrations\Project\20000101-0000-FailsHalfway.migration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SortingHat.API\SortingHat.API.csproj" />
    <ProjectReference Include="..\SortingHat.Console\SortingHat.CLI.csproj" />
    <ProjectReference Include="..\SortingHat.DB\SortingHat.DB.csproj" />
  </ItemGroup>

  <!--
    The plugins are not referenced: hat loads them at run time from their own folders.
    Their build output is copied to PluginFixtures/<plugin>/, laid out like the 'plugins' folder next to hat.
  -->
  <ItemGroup>
    <PluginFixture Include="..\SortingHat.Plugin.Exif\SortingHat.Plugin.Exif.csproj" />
    <PluginFixture Include="..\SortingHat.Plugin.FileType\SortingHat.Plugin.FileType.csproj" />
    <ProjectReference Include="@(PluginFixture)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPluginFixtures" AfterTargets="Build">
    <MSBuild Projects="@(PluginFixture)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="PluginFixtureAssembly" />
    </MSBuild>
    <ItemGroup>
      <PluginFixtureFile Include="%(PluginFixtureAssembly.RootDir)%(PluginFixtureAssembly.Directory)*.*" Plugin="%(PluginFixtureAssembly.Filename)" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFixtureFile)" DestinationFolder="$(OutDir)PluginFixtures\%(PluginFixtureFile.Plugin)" SkipUnchangedFiles="true" />
  </Target>

</Project>
