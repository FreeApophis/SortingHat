<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\test.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <DotNetCliToolReference Include="dotnet-xunit" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\test.png">
      <CustomToolNamespace>Resource</CustomToolNamespace>
    </EmbeddedResource>
    <EmbeddedResource Include="Migrations\Project\20000101-0000-FailsHalfway.migration" />
  </ItemGroup>

  <ItemGroup>
    <!-- FileTypeTest checks every signature of the FileType plugin against its own magic bytes -->
    <None Include="..\SortingHat.Plugin.FileType\Resources\FileSignatures.csv" Link="Resources\FileSignatures.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SortingHat.API\SortingHat.API.csproj" />
    <ProjectReference Include="..\SortingHat.Console\SortingHat.CLI.csproj" />
    <ProjectReference Include="..\SortingHat.DB\SortingHat.DB.csproj" />
  </ItemGroup>

  <!--
    The plugins are not referenced: hat loads them at run time from their own folders.
    The target lays out their build output like 'plugins' folders next to hat:
      PluginFixtures/Working/<plugin>/   the real plugins
      PluginFixtures/Broken/<case>/      a real plugin next to plugins that fail in every way the loader handles
  -->
  <ItemGroup>
    <PluginFixture Include="..\SortingHat.Plugin.Exif\SortingHat.Plugin.Exif.csproj" />
    <PluginFixture Include="..\SortingHat.Plugin.ExtractRelevantText\SortingHat.Plugin.ExtractRelevantText.csproj" />
    <PluginFixture Include="..\SortingHat.Plugin.FileType\SortingHat.Plugin.FileType.csproj" />
    <PluginFixture Include="..\SortingHat.Plugin.MoveOnTag\SortingHat.Plugin.MoveOnTag.csproj" />
    <PluginFixture Include="..\SortingHat.Test.Plugin\SortingHat.Test.Plugin.csproj" />
    <ProjectReference Include="@(PluginFixture)" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPluginFixtures" AfterTargets="Build">
    <MSBuild Projects="@(PluginFixture)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="PluginFixtureAssembly" />
    </MSBuild>
    <PropertyGroup>
      <Working>$(OutDir)PluginFixtures\Working\</Working>
      <Broken>$(OutDir)PluginFixtures\Broken\</Broken>
    </PropertyGroup>
    <ItemGroup>
      <PluginFixtureFile Include="%(PluginFixtureAssembly.RootDir)%(PluginFixtureAssembly.Directory)*.*" Plugin="%(PluginFixtureAssembly.Filename)" />
      <RealPluginFile Include="@(PluginFixtureFile)" Condition="'%(Plugin)' != 'SortingHat.Test.Plugin'" />
      <FileTypePluginFile Include="@(PluginFixtureFile)" Condition="'%(Plugin)' == 'SortingHat.Plugin.FileType'" />
      <FailingPluginAssembly Include="@(PluginFixtureAssembly)" Condition="'%(Filename)' == 'SortingHat.Test.Plugin'" />
      <NoModuleAssembly Include="@(FileTypePluginFile)" Condition="'%(Filename)%(Extension)' == 'Apophis.Utils.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(RealPluginFile)" DestinationFolder="$(Working)%(Plugin)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FileTypePluginFile)" DestinationFolder="$(Broken)%(Plugin)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FailingPluginAssembly)" DestinationFiles="$(Broken)ThrowsInLoad\ThrowsInLoad.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FailingPluginAssembly)" DestinationFiles="$(Broken)ThrowsInConstructor\ThrowsInConstructor.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NoModuleAssembly)" DestinationFiles="$(Broken)NoModule\NoModule.dll" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(Broken)NotAnAssembly\NotAnAssembly.dll" Lines="not an assembly" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
